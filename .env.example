# Environment variables for claims-mcp-server
# Copy to .env and fill in values

# Path to the SQLite claims database
CLAIMS_DB_PATH=data/claims.db

# Path to the API keys file (required for HTTP transport)
CLAIMS_KEYS_FILE=keys.json

# Path to the audit log file
CLAIMS_AUDIT_PATH=audit/audit.jsonl

# Rate limit: max calls per key per minute
CLAIMS_RATE_LIMIT_PER_MIN=60

# HTTP transport bind address
CLAIMS_HTTP_HOST=127.0.0.1

# HTTP transport port
CLAIMS_HTTP_PORT=8765
